{
  "name": "medtrack-hub-backend",
  "version": "1.0.0",
  "description": "",
  "author": "Pkowech",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "22.23.1"
  },
  "imports": {
    "#common/*": "./src/common/*",
    "#infrastructure/*": "./src/infrastructure/*",
    "#modules/*": "./src/modules/*"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "build": "pnpm prisma generate && pnpm run generate:proto && node -e \"if (!require('fs').existsSync('src/generated/grpc/analytics.ts')) { throw new Error('Expected generated protobuf source src/generated/grpc/analytics.ts was not created'); }\" && nest build",
    "check": "pnpm tsc --noEmit && pnpm run validate:circular && pnpm run validate:swagger",
    "start": "node dist/src/main",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "debug:swagger": "nest build && node dist/src/main",
    "format": "prettier --write \"{src,apps,libs,test}/**/*.ts\"",
    "lint": "node -e \"require('fs').accessSync('node_modules/eslint/bin/eslint.js');\" && eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:integration": "jest --config ./test/jest-integration.json",
    "test:all": "pnpm run test && pnpm run test:e2e && pnpm run test:integration",
    "prisma:generate": "prisma generate",
    "prisma:migrate": " prisma migrate dev",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:reset": "prisma migrate reset",
    "prisma:studio": "prisma studio",
    "prisma:db:push": "prisma db push",
    "prisma:db:pull": "prisma db pull",
    "seed": "tsx prisma/seeds/seed_roles.ts && tsx prisma/seeds/seed.ts && tsx prisma/seeds/courses.seed.ts",
    "docker:dev": "docker-compose up server-dev --build",
    "docker:dev:clean": "docker-compose down -v && docker-compose up server-dev --build",
    "docker:logs": "docker-compose logs -f server-dev",
    "docker:shell": "docker-compose exec server-dev sh",
    "docker:db": "docker-compose up -d postgres",
    "docker:redis": "docker-compose up -d redis",
    "docker:services": "docker-compose up -d postgres redis",
    "prisma:studio:docker": "docker-compose exec server pnpm prisma studio --hostname 0.0.0.0",
    "prisma:migrate:docker": "docker-compose exec server-dev pnpm prisma migrate dev",
    "prisma:reset:docker": "docker-compose exec server-dev pnpm prisma migrate reset",
    "docker:down": "docker-compose down",
    "docker:down:volumes": "docker-compose down -v",
    "generate:proto": "node -e \"require('fs').mkdirSync('src/generated/grpc', { recursive: true })\" && protoc --plugin=protoc-gen-ts_proto=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=src/generated/grpc --ts_proto_opt=nestJs=true,outputServices=grpc-js,paths=source_relative -I ../protos -I ./node_modules/grpc-tools/bin -I /usr/include ../protos/*.proto",
    "convert:extract": "ts-node scripts/convert_extract_to_seed.ts",
    "backend:upload-files": "ts-node scripts/upload_files_to_s3.ts",
    "validate:circular": "madge --circular src/",
    "validate:swagger": "node -r ts-node/register scripts/validate-swagger.ts",
    "validate:types": "tsc --noEmit",
    "validate:dto": "pnpm run validate:types && pnpm run validate:circular && pnpm run validate:swagger",
    "precommit": "pnpm run lint && pnpm run validate:types && pnpm run validate:circular"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.57.0",
    "@aws-sdk/client-s3": "^3.1145.0",
    "@aws-sdk/s3-request-presigner": "^3.1145.0",
    "@bufbuild/protobuf": "^2.16.0",
    "@grpc/grpc-js": "^1.14.5",
    "@keyv/redis": "^3.0.1",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/cache-manager": "^3.1.3",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.2.7",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@prisma/client-runtime-utils": "^7.10.0",
    "argon2": "^0.41.1",
    "axios": "^1.20.0",
    "bullmq": "^5.81.5",
    "cache-manager": "^6.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "googleapis": "^182.0.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "ip-range-check": "^0.2.1",
    "joi": "^17.13.8",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.18.1",
    "multer": "^2.4.0",
    "nestjs-pino": "^4.6.1",
    "node-addon-api": "^8.9.2",
    "node-gyp-build": "^4.8.4",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "pino-http": "^10.5.0",
    "prisma": "^7.10.0",
    "prom-client": "^15.1.3",
    "protobufjs": "^7.6.6",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "speakeasy": "^2.0.0",
    "uuid": "^13.0.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@grpc/proto-loader": "^0.7.15",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.7",
    "@prisma/internals": "7.0.0",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.16.13",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.25",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/speakeasy": "^2.0.10",
    "@types/supertest": "^6.0.3",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^16.5.0",
    "grpc-tools": "^1.13.1",
    "madge": "^8.0.0",
    "pino-pretty": "^13.1.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "ts-proto": "^2.12.4",
    "ts-protoc-gen": "^0.15.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
