# Database configuration for sqlx compile-time checking
# Copy this to .env and update with your actual database URL
DATABASE_URL=postgresql://user:password@localhost:5432/medical_tracker

# Runtime configuration
RUST_LOG=info
RUST_ANALYTICS_HOST=0.0.0.0
RUST_ANALYTICS_PORT=8000
RUST_ANALYTICS_GRPC_HOST=0.0.0.0
RUST_ANALYTICS_GRPC_PORT=50051
RUST_ANALYTICS_API_KEY=
# Gotenberg for document conversions (optional runtime dependency)
GOTENBERG_URL=http://localhost:3010
